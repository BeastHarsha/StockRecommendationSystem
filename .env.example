# Copy this file to .env and fill in your values. Never commit .env.

# Groww authentication. Use a direct access token OR an API key and secret pair.
# Direct access tokens expire daily and must be refreshed in .env.
# API key and secret authentication requires daily approval in Groww Cloud.
# Not needed when USE_MOCK_GROWW=true.
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=

# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna

# Use sample portfolio data instead of the real Groww API
USE_MOCK_GROWW=true

# Monitoring
PRICE_DROP_THRESHOLD_PCT=5
POLL_INTERVAL_MINUTES=15
MAX_SELF_CHECK_RETRIES=3

# RAG
CHROMA_PERSIST_DIR=storage/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
